# PostgreSQL of the location service: base `location`, role `location`, data on the `location-data`
# volume. The compose `location-db` container publishes no port, so a local `make -C backend/location
# run` or the integration tests need their own PostgreSQL; see quickstart §7.
# Copy this file to .env: compose and the make targets read only that local copy. The password and
# the DSN below repeat it, so change both together.
CABBY_LOCATION_DB_PASSWORD=change-me
CABBY_LOCATION_DB_URL=postgres://location:change-me@location-db:5432/location?sslmode=disable
CABBY_LOCATION_GRPC_PORT=9095
