# PostgreSQL of the auth service: base `auth`, role `auth`, data on the `auth-data` volume.
# The compose `postgres` container publishes no port (R-05), so a local `make -C backend/auth
# run` or the integration tests need their own PostgreSQL; see quickstart §5.
# Copy this file to .env: compose and the make targets read only that local copy. The password and
# the DSN below repeat it, so change both together.
CABBY_AUTH_DB_PASSWORD=change-me
CABBY_AUTH_DB_URL=postgres://auth:change-me@postgres:5432/auth?sslmode=disable
CABBY_AUTH_GRPC_PORT=9093
