meta {
  name: 17 location, longitude is null
  type: http
  seq: 17
}

post {
  url: {{host}}/cabber/location
  body: json
  auth: bearer
}

auth:bearer {
  token: {{smokeToken}}
}

body:json {
  { "latitude": 55.7558, "longitude": null }
}

assert {
  res.status: eq 400
  res.body.error.code: eq invalid_request
  res.body.error.field: eq longitude
}
