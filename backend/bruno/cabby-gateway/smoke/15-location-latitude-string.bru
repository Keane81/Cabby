meta {
  name: 15 location, latitude is a string
  type: http
  seq: 15
}

post {
  url: {{host}}/cabber/location
  body: json
  auth: bearer
}

auth:bearer {
  token: {{smokeToken}}
}

body:json {
  { "latitude": "55.7", "longitude": 37.6173 }
}

assert {
  res.status: eq 400
  res.body.error.code: eq invalid_request
  res.body.error.field: eq latitude
}
