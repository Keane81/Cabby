meta {
  name: 16 location, longitude is absent
  type: http
  seq: 16
}

post {
  url: {{host}}/cabber/location
  body: json
  auth: bearer
}

auth:bearer {
  token: {{smokeToken}}
}

body:json {
  { "latitude": 55.7558 }
}

assert {
  res.status: eq 400
  res.body.error.code: eq invalid_request
  res.body.error.field: eq longitude
}
