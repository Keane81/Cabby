# DB viewer (specs/006-db-viewer): a read-only, local-only page over the auth and location databases.
# The DSNs repeat the roles and passwords of backend/auth/.env and backend/location/.env — change
# them together. The compose databases publish no port, so the hosts below resolve only inside the
# compose network; a host run (`make -C backend/dbviewer run`) needs its own PostgreSQL addresses.
# Copy this file to .env: compose and the make targets read only that local copy.
CABBY_DBVIEWER_AUTH_DB_URL=postgres://auth:change-me@auth-db:5432/auth?sslmode=disable
CABBY_DBVIEWER_LOCATION_DB_URL=postgres://location:change-me@location-db:5432/location?sslmode=disable
CABBY_DBVIEWER_HTTP_PORT=8090
